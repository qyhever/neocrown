### app
get http://{{host}}/api HTTP/1.1
Content-Type: application/json

### meta
get http://{{host}}/api/meta HTTP/1.1

### user list
get http://{{host}}/api/user HTTP/1.1
Authorization: Bearer {{token}}

### user detail
get http://{{host}}/api/user/14 HTTP/1.1
Authorization: Bearer {{token}}

### current user
get http://{{host}}/api/user/me HTTP/1.1
Authorization: Bearer {{token}}

### user create（临时兼容入口：可绕过邮箱验证，待废弃）
post http://{{host}}/api/user HTTP/1.1
Content-Type: application/json

{
  "username": "testuser1",
  "nickname": "Test User",
  "email": "testuser@example.com",
  "password": "password123",
  "isEnabled": true
}

### send registration verification code
post http://{{host}}/api/auth/registration-code HTTP/1.1
Content-Type: application/json

{
  "email": "buneo@6688988.xyz"
}

### register with verification code
post http://{{host}}/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "new-user1",
  "nickname": "New User1",
  "email": "buneo@6688988.xyz",
  "password": "password123",
  "verificationCode": "160304"
}

### login
post http://{{host}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "buneo@6688988.xyz",
  "password": "password123"
}

### refresh tokens
post http://{{host}}/api/auth/refresh HTTP/1.1
Content-Type: application/json

{
  "refreshToken": "replace-with-refresh-token"
}

### user update
patch http://{{host}}/api/user HTTP/1.1
Content-Type: application/json

{
  "id": 14,
  "username": "zhangsan"
}

### user delete
delete http://{{host}}/api/user/14 HTTP/1.1

### user batch delete
post http://{{host}}/api/user/batch-delete HTTP/1.1
Content-Type: application/json

{
  "ids": [14, 15]
}

### user page list
post http://{{host}}/api/user/page HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPage": 1,
  "pageSize": 10,
  "rangeDate": []
}
