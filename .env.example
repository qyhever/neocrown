# 应用监听端口
PORT=8300

# 数据库类型，可选值：mysql、postgres
DB_TYPE=mysql
# 数据库名称
DB_DATABASE=neocrown
# 数据库主机地址
DB_HOST=localhost
# 数据库端口，MySQL 默认 3306
DB_PORT=3306
# 数据库用户名
DB_USERNAME=root
# 数据库密码
DB_PASSWORD=root123
# 是否启用 TypeORM 自动同步表结构；生产环境建议保持 false
DB_SYNC=false

# JWT 签名密钥；生产环境请替换为足够复杂的随机字符串
JWT_SECRET=testsecret
# Access Token 有效期，支持 ms、s、m、h、d、w、y 等单位
JWT_ACCESS_EXPIRE=2h
# Refresh Token 有效期，支持 ms、s、m、h、d、w、y 等单位
JWT_REFRESH_EXPIRE=72h
# JWT 签发方标识
JWT_ISSUER=neocrown
# bcrypt 哈希轮数，当前校验范围为 10-15
BCRYPT_ROUNDS=10

# 日志目录名称
LOG_DIRNAME=logs
# 是否启用文件日志输出
LOG_FILE_ENABLED=false
# 日志文件名模板，%DATE% 会按 LOG_DATE_PATTERN 替换
LOG_FILENAME=application-%DATE%.log
# 日志文件日期格式
LOG_DATE_PATTERN=YYYY-MM-DD
# 单个日志文件最大体积
LOG_MAX_SIZE=1m
# 日志文件保留时间或数量
LOG_MAX_FILES=30d

# SMTP服务器地址
POSTAL_SMTP_SERVER=mail.example.com
# SMTP端口(优先465)
POSTAL_SMTP_PORT=465
# 发件邮箱
POSTAL_FROM_EMAIL=noreply@example.com
# 发件邮箱密码
POSTAL_FROM_PASS=from_password
# 发件人显示名称
POSTAL_FROM_NAME=Neocrown

# 发送邮箱验证码的签名密钥；生产环境请替换为足够复杂的随机字符串
EMAIL_VERIFICATION_SECRET=verification_secret

# V2EX 今日热贴 Top 10 定时邮件收件人
V2EX_HOT_TOP10_MAIL_TO=receiver@example.com
